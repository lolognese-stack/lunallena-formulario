# Armador (Next.js en Vercel, proyecto lunallena-planificador). Copiar a .env.local para desarrollo.
# En Vercel: Project → Settings → Environment Variables. Nunca subir valores reales al repo.

# --- Supabase (catálogo, itinerarios y leads) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # solo lee el catálogo
SUPABASE_SECRET_KEY=sb_secret_xxx                        # servidor: itinerarios, leads, eventos, cola
# ITINERARIOS_EN_MEMORIA=1                               # solo para probar el build sin base

# --- Mails (Resend) ---
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=whsec_xxx      # Resend → Webhooks → signing secret
MAIL_FROM="Luna Llena Travel <viajes@lunallenatravel.com>"
ALERTAS_EMAIL=equipo@ejemplo.com     # alertas internas (calificado sin contactar a los 30 min, etc.)

# --- WhatsApp ---
NUMERO_AGENCIA_WHATSAPP=51930299443  # solo dígitos, con código de país

# --- Cron de la cola de mails ---
CRON_SECRET=un-secreto-largo-y-aleatorio   # el Worker de Cloudflare manda "Authorization: Bearer <CRON_SECRET>"

# --- Otros ---
URL_PUBLICA=https://lunallenatravel.vercel.app/armador
HASH_SALT=otro-secreto-aleatorio     # sal para hashear IPs y huellas de idempotencia
SOLES_POR_USD=3.75                   # para pasar el precio "desde" del motor (soles) a USD
