{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/guia/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/armador",
      "destination": "https://lunallena-planificador.vercel.app/armador"
    },
    {
      "source": "/armador/:path*",
      "destination": "https://lunallena-planificador.vercel.app/armador/:path*"
    },
    {
      "source": "/api/evento-web/",
      "destination": "https://crm-plantilla.pages.dev/api/evento-web"
    },
    {
      "source": "/api/cotizacion-web/",
      "destination": "https://crm-plantilla.pages.dev/api/cotizacion-web"
    },
    {
      "source": "/api/cotizar-web/",
      "destination": "https://crm-plantilla.pages.dev/api/cotizar-web"
    },
    {
      "source": "/api/evento-form/",
      "destination": "https://crm-plantilla.pages.dev/api/evento-form"
    },
    {
      "source": "/api/pais/",
      "destination": "/api/pais"
    }
  ]
}
